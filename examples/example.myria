let digit = func ( a ) {
   let copy = a
    a /= 10
    a *= 10
    copy - a
} 
print("digit(6789) = ", digit(6789))

let y = if false {
        let x = 30
        x * 0.5
    } elif true {
        50
    } else {
        5
    }
print(y + 5)

